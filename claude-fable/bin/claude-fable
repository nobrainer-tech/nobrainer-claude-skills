#!/usr/bin/env bash
# claude-fable — launch Claude Code with community-leaked "Claude Fable 5" system prompt(s)
# and --dangerously-skip-permissions.
#
# Variants (CLAUDE_FABLE_VARIANT):
#   codecli (default) — the Claude Code agentic Fable 5 prompt (--system-prompt-file).
#   both              — Claude Code agentic prompt as base PLUS the consumer chat persona
#                       appended (--append-system-prompt-file).
#   chat              — only the consumer claude.ai Fable 5 chat prompt.
#
# Sources (community leaks, NOT official Anthropic):
#   code: asgeirtj/system_prompts_leaks  Anthropic/Claude Code/claude-code-2.1.172-fable-5.md
#   chat: elder-plinius/CL4R1T4S         ANTHROPIC/CLAUDE-FABLE-5.md
#
# Reality check: this swaps system-prompt TEXT on whatever model your Claude Code runs.
# It does NOT change the underlying model — persona/behavior experiment, not a capability bump.
#
# Usage:
#   claude-fable                          # interactive, Claude Code Fable prompt (default)
#   claude-fable -p "..."                 # one-shot (non-interactive)
#   claude-fable --update                 # re-download the variant's prompt(s), then launch
#   CLAUDE_FABLE_VARIANT=codecli|chat|both claude-fable
#   CLAUDE_FABLE_MODE=append claude-fable  # single-variant only: append instead of replace
#   CLAUDE_FABLE_DRYRUN=1 claude-fable     # print the command, don't run it
#   claude-fable <extra claude flags...>   # passed through to `claude`
set -euo pipefail

SKILL_DIR="${CLAUDE_FABLE_DIR:-$HOME/.claude/skills/claude-fable}"
VARIANT="${CLAUDE_FABLE_VARIANT:-codecli}"

CC_FILE="$SKILL_DIR/CLAUDE-CODE-FABLE-5.md"
CC_URL="https://raw.githubusercontent.com/asgeirtj/system_prompts_leaks/main/Anthropic/Claude%20Code/claude-code-2.1.172-fable-5.md"
CHAT_FILE="$SKILL_DIR/CLAUDE-FABLE-5.md"
CHAT_URL="https://raw.githubusercontent.com/elder-plinius/CL4R1T4S/main/ANTHROPIC/CLAUDE-FABLE-5.md"

DO_UPDATE=""
if [ "${1:-}" = "--update" ]; then DO_UPDATE=1; shift; fi

# ensure <file> <url> — download if missing, or always when --update was passed
ensure() {
  local file="$1" url="$2"
  if [ -n "$DO_UPDATE" ] || [ ! -s "$file" ]; then
    echo "claude-fable: fetching $(basename "$file")" >&2
    mkdir -p "$SKILL_DIR"
    curl -fsSL "$url" -o "$file"
  fi
}

if ! command -v claude >/dev/null 2>&1; then
  echo "claude-fable: 'claude' CLI not found on PATH." >&2
  exit 127
fi

CMD=(claude --dangerously-skip-permissions)
case "$VARIANT" in
  both)
    ensure "$CC_FILE" "$CC_URL"
    ensure "$CHAT_FILE" "$CHAT_URL"
    CMD+=(--system-prompt-file "$CC_FILE" --append-system-prompt-file "$CHAT_FILE")
    ;;
  codecli)
    ensure "$CC_FILE" "$CC_URL"
    local_flag="--system-prompt-file"
    [ "${CLAUDE_FABLE_MODE:-replace}" = "append" ] && local_flag="--append-system-prompt-file"
    CMD+=("$local_flag" "$CC_FILE")
    ;;
  chat)
    ensure "$CHAT_FILE" "$CHAT_URL"
    local_flag="--system-prompt-file"
    [ "${CLAUDE_FABLE_MODE:-replace}" = "append" ] && local_flag="--append-system-prompt-file"
    CMD+=("$local_flag" "$CHAT_FILE")
    ;;
  *)
    echo "claude-fable: unknown CLAUDE_FABLE_VARIANT='$VARIANT' (use 'both', 'codecli', or 'chat')" >&2
    exit 2
    ;;
esac

CMD+=("$@")

if [ -n "${CLAUDE_FABLE_DRYRUN:-}" ]; then
  printf '%q ' "${CMD[@]}"; echo
  exit 0
fi

exec "${CMD[@]}"

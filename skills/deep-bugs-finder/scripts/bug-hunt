#!/usr/bin/env bash
# deep-bugs-finder :: adversarial bug-hunt loop (steipete method)
#
# Core idea: a neutral "are there bugs?" makes the model answer "looks good".
# Instead we ASSERT a real bug exists and LOOP — each round told what was already
# found, demanded to dig for DIFFERENT, deeper issues. This surfaces real bugs
# that a single neutral pass misses.
#
# This helper only GENERATES candidate findings (read-only). It does NOT decide
# truth and does NOT write bug files — the agent verifies each candidate against
# the real code and writes bugs/<NNN>-<slug>.md (see SKILL.md).
#
# Usage:
#   bug-hunt --base origin/main          # review branch diff vs base
#   bug-hunt --diff                      # review uncommitted working-tree diff
#   bug-hunt --paths "a.py b.py"         # review specific files (whole content)
#   bug-hunt --commit HEAD               # review one commit
#   [--rounds N] (default 4)  [--engine codex] (default)  [--out FILE]
#
# Output: appends each round's raw findings to --out (default ./bugs/.bug-hunt-candidates.md)
# and streams them to stdout. Exit 0 always (candidate generation is advisory).

set -uo pipefail

ROUNDS=4
ENGINE="codex"
MODE=""
BASE=""
COMMIT=""
PATHS=""
OUT=""

while [ $# -gt 0 ]; do
  case "$1" in
    --base) MODE="branch"; BASE="$2"; shift 2;;
    --diff|--local|--uncommitted) MODE="diff"; shift;;
    --commit) MODE="commit"; COMMIT="$2"; shift 2;;
    --paths) MODE="paths"; PATHS="$2"; shift 2;;
    --rounds) ROUNDS="$2"; shift 2;;
    --engine) ENGINE="$2"; shift 2;;
    --out) OUT="$2"; shift 2;;
    -h|--help) sed -n '2,30p' "$0"; exit 0;;
    *) echo "unknown arg: $1" >&2; exit 2;;
  esac
done

if [ -z "$MODE" ]; then
  echo "ERROR: pick a scope: --base <ref> | --diff | --commit <ref> | --paths \"<files>\"" >&2
  exit 2
fi

# The LOOP is driven by THIS SCRIPT (re-invoking the engine each round), not by
# any model's internal looping — so it behaves identically for Codex and Claude.
case "$ENGINE" in
  codex|claude|both) ;;
  *) echo "ERROR: --engine must be codex|claude|both" >&2; exit 2;;
esac
for e in $( [ "$ENGINE" = both ] && echo "codex claude" || echo "$ENGINE" ); do
  command -v "$e" >/dev/null 2>&1 || { echo "ERROR: engine '$e' not on PATH" >&2; exit 2; }
done

# run_engine <engine> <prompt-text> -> prints the engine's response (read-only)
run_engine() {
  local eng="$1" pr="$2"
  case "$eng" in
    codex)  printf '%s' "$pr" | codex exec --skip-git-repo-check --sandbox read-only 2>/dev/null;;
    claude) printf '%s' "$pr" | claude -p --permission-mode plan 2>/dev/null;;
  esac
}

# --- build the code context to review ---------------------------------------
context_file="$(mktemp -t bughunt-ctx.XXXXXX)"
trap 'rm -f "$context_file"' EXIT
case "$MODE" in
  branch) git diff "$BASE"...HEAD > "$context_file" 2>/dev/null || git diff "$BASE" > "$context_file";;
  diff)   { git diff; git diff --staged; } > "$context_file";;
  commit) git show "$COMMIT" > "$context_file";;
  paths)  for f in $PATHS; do echo "===== FILE: $f ====="; cat "$f"; echo; done > "$context_file";;
esac

if [ ! -s "$context_file" ]; then
  echo "ERROR: empty review context (nothing to review for the chosen scope)" >&2
  exit 2
fi

OUT="${OUT:-bugs/.bug-hunt-candidates.md}"
mkdir -p "$(dirname "$OUT")"
: > "$OUT"

ctx_bytes=$(wc -c < "$context_file")
echo "bug-hunt: mode=$MODE engine=$ENGINE rounds=$ROUNDS context=${ctx_bytes}B out=$OUT" >&2

accumulated=""   # titles already surfaced, fed back each round to force deeper digging

base_prompt='You are a SKEPTICAL, ADVERSARIAL bug hunter. ASSUME there is at least one REAL, concrete bug in the code/diff below — "looks good" / "no issues" is NOT an acceptable answer on its own; you must dig until you can prove findings against the actual code.

Hunt for REAL defects only: logic errors, off-by-one, null/None/undefined, wrong operator/comparison, incorrect assumptions, race conditions / TOCTOU, unhandled errors & silent failures, resource/lock leaks, incorrect error propagation, broken edge cases, security holes (injection, path traversal, auth bypass, secret leak), data corruption, API/contract misuse, fail-OPEN where it should fail-closed.

Do NOT report: style, naming, formatting, missing comments/docs, speculative "could be cleaner", or hypothetical inputs the code never receives.

For EACH bug output EXACTLY this block (repeat per bug):
### BUG
- file: <path>:<line or range>
- severity: Critical|High|Medium
- title: <one line>
- why_real: <concrete failure scenario / input that triggers wrong behaviour — cite the exact code>
- root_cause: <the underlying mistake>
- fix: <specific proposed change; include a short code snippet if useful>
- confidence: <0-100>

If after deep analysis you truly find nothing new, output the single line: NO_NEW_BUGS_FOUND'

for r in $(seq 1 "$ROUNDS"); do
  echo "=== round $r/$ROUNDS ===" >&2
  if [ -n "$accumulated" ]; then
    loop_note="Already surfaced in earlier rounds (do NOT repeat these — find DIFFERENT, deeper bugs; if you reconsider one as false, say so):
$accumulated"
  else
    loop_note="(first round)"
  fi

  prompt="$base_prompt

$loop_note

CODE / DIFF UNDER REVIEW:
\`\`\`
$(cat "$context_file")
\`\`\`"

  if [ "$ENGINE" = "both" ]; then
    round_out="$(printf '### codex\n'; run_engine codex "$prompt"; printf '\n### claude\n'; run_engine claude "$prompt")"
  else
    round_out=$(run_engine "$ENGINE" "$prompt")
  fi

  {
    echo ""
    echo "<!-- ===== bug-hunt round $r ($ENGINE) ===== -->"
    echo "$round_out"
  } >> "$OUT"
  echo "$round_out"

  # accumulate titles to feed back next round
  new_titles=$(printf '%s\n' "$round_out" | grep -iE '^- title:' | sed 's/^- title:[[:space:]]*//')
  [ -n "$new_titles" ] && accumulated="$accumulated
$new_titles"

  # stop early if two engines agree there is nothing new (dry)
  if printf '%s' "$round_out" | grep -q "NO_NEW_BUGS_FOUND" && [ "$r" -ge 2 ]; then
    echo "bug-hunt: dry round at $r — stopping" >&2
    break
  fi
done

echo "" >&2
echo "bug-hunt: candidates written to $OUT — NOW VERIFY each against real code before writing bug files." >&2
exit 0
